rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Check if user is accessing their own profile
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // User profiles & user tasks
    match /users/{userId} {
      allow read, write: if isSignedIn() || request.auth == null;
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() || request.auth == null;
      }
    }

    // School collections (Students, Teachers, Classes, Majors, Attendance, Backups)
    match /students/{studentId} {
      allow read, write: if true;
    }

    match /teachers/{teacherId} {
      allow read, write: if true;
    }

    match /classes/{classId} {
      allow read, write: if true;
    }

    match /majors/{majorId} {
      allow read, write: if true;
    }

    match /attendance/{attendanceId} {
      allow read, write: if true;
    }

    match /teacher_attendance/{id} {
      allow read, write: if true;
    }

    match /backups/{backupId} {
      allow read, write: if true;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

